<?xml version="1.0" encoding="utf-8"?>
<!--
  Baromi launcher foreground: a lowercase "b" whose bowl holds a small barometer dial + needle.
  Stem + bowl are white; the bowl counter is a true hole (evenOdd) so the teal background shows
  through, and the dial (cyan scale + amber needle) sits inside that opening. Wrapped in a group
  scaled to keep the mark inside the adaptive-icon safe zone across mask shapes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="mark"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <!-- stem (ascender) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35,14 H42 A3,3 0 0 1 45,17 V87 A3,3 0 0 1 42,90 H35 A3,3 0 0 1 32,87 V17 A3,3 0 0 1 35,14 Z" />
        <!-- bowl ring: outer circle with the counter as a concentric hole -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M32,64 A25,25 0 1 1 82,64 A25,25 0 1 1 32,64 Z M43.5,64 A13.5,13.5 0 1 0 70.5,64 A13.5,13.5 0 1 0 43.5,64 Z" />
        <!-- dial scale arc -->
        <path
            android:strokeColor="#6FF6FF"
            android:strokeWidth="1.8"
            android:pathData="M46,65 Q57,49 68,65" />
        <!-- dial ticks -->
        <path
            android:fillColor="#6FF6FF"
            android:pathData="M45.7,61 A1.3,1.3 0 1 1 48.3,61 A1.3,1.3 0 1 1 45.7,61 Z" />
        <path
            android:fillColor="#6FF6FF"
            android:pathData="M55.6,50 A1.4,1.4 0 1 1 58.4,50 A1.4,1.4 0 1 1 55.6,50 Z" />
        <path
            android:fillColor="#6FF6FF"
            android:pathData="M65.7,61 A1.3,1.3 0 1 1 68.3,61 A1.3,1.3 0 1 1 65.7,61 Z" />
        <!-- needle -->
        <path
            android:fillColor="#F5BD48"
            android:pathData="M58.6,69 L55.4,67 L66,54 Z" />
        <!-- hub -->
        <path
            android:fillColor="#F5BD48"
            android:pathData="M54,68 A3,3 0 1 1 60,68 A3,3 0 1 1 54,68 Z" />
        <path
            android:fillColor="#00696F"
            android:pathData="M55.8,68 A1.2,1.2 0 1 1 58.2,68 A1.2,1.2 0 1 1 55.8,68 Z" />
    </group>
</vector>
