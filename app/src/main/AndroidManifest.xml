<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Local-only app: no INTERNET permission in v1. Data stays on device.
      allowBackup is false so wellbeing data is not copied off-device by system backup.
      No launcher activity yet — the capture UI (Module B) adds it.
    -->
    <application
        android:allowBackup="false"
        android:label="Baromi"
        android:supportsRtl="true" />

</manifest>
